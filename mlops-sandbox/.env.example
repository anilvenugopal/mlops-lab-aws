# Copy this file to .env and adjust if any port here conflicts with
# something already running on your machine. .env is gitignored —
# .env.example is the committed template with safe defaults.

# Postgres is on 5433, not the standard 5432, because this machine already
# runs a native PostgreSQL install on 5432 (postgresql@18-main.service).
# We leave that alone entirely and use a different port for the sandbox.
POSTGRES_PORT=5433
POSTGRES_USER=mlplatform
POSTGRES_PASSWORD=mlplatform_local_dev
POSTGRES_DB=mlplatform

MLFLOW_PORT=5000
